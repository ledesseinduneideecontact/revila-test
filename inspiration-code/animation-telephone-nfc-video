<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Téléphone → notif NFC → vidéo plein écran (triangle)</title>
<style>
  :root{
    --ink:#0f172a; --muted:#64748b; --nfc:#3b82f6; --bg:#eef3ff;
    --t-arrive:1100ms; --t-toast-in:600ms; --t-toast-hold:1100ms; --t-toast-out:400ms; --t-player-in:350ms;
  }
  html,body{height:100%;margin:0;background:radial-gradient(1200px 800px at 50% -10%,#fff,var(--bg));color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,Segoe UI,Roboto,Arial}
  .demo{width:860px;max-width:96vw;aspect-ratio:16/9;background:linear-gradient(180deg,#fff,#fafcff);border-radius:24px;box-shadow:0 16px 48px rgba(15,23,42,.16);margin:auto;position:relative;overflow:hidden;perspective:1600px}
  .hint{position:absolute;bottom:12px;left:14px;background:rgba(255,255,255,.9);border-radius:999px;padding:6px 10px;font-size:12px;color:var(--muted);z-index:2}
  .btn{position:absolute;bottom:12px;right:12px;border:0;border-radius:999px;background:#0f172a;color:#fff;padding:8px 12px;font:600 12px/1 Inter;cursor:pointer}

  /* Photo */
  .photo-wrap{position:absolute;left:7.5%;top:19.5%;width:480px;height:330px;transform:rotate(-2deg)}
  .frame{position:absolute;inset:-16px;border-radius:22px;background:#fff;box-shadow:inset 0 0 0 1px rgba(0,0,0,.07),0 14px 36px rgba(0,0,0,.12)}
  .photo{position:absolute;inset:0;border-radius:18px;overflow:hidden;background:
    linear-gradient(190deg,rgba(255,255,255,.35) 0,rgba(255,255,255,0) 40%),
    url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="480" height="330"><defs><linearGradient id="sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="%23bfe5ff"/><stop offset="65%" stop-color="%2386d5ff"/><stop offset="100%" stop-color="%2368c1ff"/></linearGradient></defs><rect width="480" height="330" fill="url(%23sky)"/><circle cx="400" cy="56" r="12" fill="%23ffd54a"/><g fill="%2387c79a"><polygon points="30,190 110,100 190,190"/><polygon points="120,188 200,92 280,188"/><polygon points="210,194 300,120 390,194"/></g><rect x="0" y="200" width="480" height="130" fill="%236ecbff"/></svg>');
    background-size:cover}
  .grain{position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;opacity:.08;background-image:repeating-linear-gradient(0deg,rgba(0,0,0,.04) 0 1px,transparent 1px 2px),repeating-linear-gradient(90deg,rgba(0,0,0,.02) 0 1px,transparent 1px 3px)}

  /* Onde NFC */
  .nfc-ripple{position:absolute;right:0;bottom:0;width:220px;height:220px;pointer-events:none}
  .nfc-ripple span{position:absolute;right:10px;bottom:10px;width:24px;height:24px;border-radius:999px;border:2px solid rgba(59,130,246,.9);box-shadow:0 0 20px rgba(59,130,246,.65) inset;transform:scale(.8);opacity:0}
  .demo.is-toast .nfc-ripple span{animation:rip 1.6s ease-out .05s 2}
  @keyframes rip{0%{opacity:0;transform:scale(.8)}20%{opacity:1}100%{opacity:0;transform:scale(6)}}

  /* Téléphone (arrive) */
  .phone{position:absolute;width:300px;height:600px;border-radius:38px;background:#0b1428;box-shadow:0 34px 70px rgba(5,10,30,.35),inset 0 0 0 2px rgba(255,255,255,.06);display:grid;place-items:center;transform:rotate(12deg);
    offset-path:path("M 820,120 C 700,180 540,220 470,260 C 420,290 380,320 360,350");offset-distance:0%;offset-rotate:0deg}
  .screen{width:266px;height:566px;border-radius:32px;overflow:hidden;background:linear-gradient(180deg,#eaf2ff,#f7fbff);position:relative}

  /* Grille (masquée quand la vidéo apparaît) */
  .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;padding:18px;transition:opacity .25s ease}
  .thumb{height:76px;border-radius:12px;background:#cfe7ff}
  .thumb:nth-child(2){background:#c8f5d4}.thumb:nth-child(3){background:#ffd7e8}
  .thumb:nth-child(4){background:#f8e0a6}.thumb:nth-child(5){background:#cfe7ff}
  .thumb:nth-child(6){background:#c8f5d4}.thumb:nth-child(7){background:#ffd7e8}
  .thumb:nth-child(8){background:#f8e0a6}.thumb:nth-child(9){background:#cfe7ff}

  /* Notification NFC (in/out) */
  .toast{position:absolute;left:14px;right:14px;top:16px;min-height:58px;border-radius:16px;background:rgba(15,23,42,.95);color:#fff;display:flex;align-items:center;gap:10px;padding:10px 14px;transform:translateY(-90px);opacity:0}
  .dot{width:14px;height:14px;border-radius:50%;background:#60a5fa;box-shadow:0 0 12px rgba(96,165,250,.9)}
  .label{font:600 14px/1.15 Inter}.small{font:500 12px/1 Inter;opacity:.7;margin-left:auto}
  .demo.is-toast .toast{transform:translateY(0);opacity:1;transition:transform var(--t-toast-in) cubic-bezier(.2,.7,.2,1),opacity var(--t-toast-in)}
  .demo.toast-off .toast{transform:translateY(-90px);opacity:0;transition:transform var(--t-toast-out) ease,opacity var(--t-toast-out)}

  /* Lecteur symbolique PLEIN ÉCRAN dans le téléphone */
  .inline-video{
    position:absolute; inset:0;
    border-radius:inherit;
    background:linear-gradient(180deg,#0b1325,#0f1b3a);
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.06),0 10px 24px rgba(0,0,0,.25);
    display:grid; place-items:center;
    opacity:0; transform:translateY(8px) scale(.98);
    pointer-events:none; z-index:2;
  }
  .play-icon{position:relative;width:min(40%,160px);height:min(40%,160px);border-radius:999px;background:rgba(255,255,255,.1);display:grid;place-items:center;opacity:.96}
  .play-icon::before{content:"";border-style:solid;border-width:16px 0 16px 26px;border-color:transparent transparent transparent #ffffff;display:block;transform:translateX(4px)}
  .wave,.wave2{position:absolute;inset:0;border-radius:999px;border:2px solid rgba(255,255,255,.35);opacity:0}
  .progress{position:absolute;left:0;right:0;bottom:0;height:8px;background:rgba(255,255,255,.08);overflow:hidden;border-bottom-left-radius:inherit;border-bottom-right-radius:inherit}
  .progress::after{content:"";position:absolute;left:0;top:0;bottom:0;width:0;background:#3b82f6}

  .demo.playing .inline-video{opacity:1;transform:translateY(0) scale(1);transition:opacity var(--t-player-in) ease,transform var(--t-player-in)}
  .demo.playing .gallery{display:none}
  .demo.playing .wave{animation:outwave 1.6s ease-out .1s infinite}
  .demo.playing .wave2{animation:outwave 1.6s ease-out .9s infinite}
  .demo.playing .progress::after{animation:prog 6s linear infinite}
  @keyframes outwave{0%{opacity:.0;transform:scale(.9)}20%{opacity:.9}100%{opacity:0;transform:scale(1.8)}}
  @keyframes prog{from{width:0}to{width:100%}}

  /* Séquence 1 : arrivée */
  .demo.arrive .phone{animation:moveAlong var(--t-arrive) cubic-bezier(.32,0,.67,0) forwards}
  @keyframes moveAlong{from{offset-distance:0%;transform:rotate(12deg)}to{offset-distance:100%;transform:rotate(-6deg)}}

  /* Fallback sans offset-path */
  .no-path .phone{left:62%;top:14%;transform:rotate(12deg)}
  .no-path.arrive .phone{animation:approx .9s cubic-bezier(.32,0,.67,0) forwards}
  @keyframes approx{from{transform:translate(-40vw,26vh) rotate(12deg)}to{transform:translate(-18vw,36vh) rotate(-6deg)}}

  @media (prefers-reduced-motion: reduce){ .demo, .demo *{animation:none !important;transition:none !important} }
</style>
</head>
<body>
<div class="demo" id="demo" aria-label="1) Le téléphone arrive 2) notif NFC 3) notif sort 4) vidéo plein écran (triangle)">
  <div class="photo-wrap">
    <div class="frame"></div>
    <div class="photo">
      <div class="grain"></div>
      <div class="nfc-ripple" aria-hidden="true"><span></span></div>
    </div>
  </div>

  <div class="phone" aria-hidden="true">
    <div class="screen" id="screen">
      <div class="toast" id="toast" aria-hidden="true">
        <span class="dot"></span><span class="label">NFC détecté — Appuyez pour ouvrir</span><span class="small">Sécurisé</span>
      </div>

      <div class="inline-video" aria-hidden="true">
        <div class="play-icon"><span class="wave"></span><span class="wave2"></span></div>
        <div class="progress"></div>
      </div>

      <div class="gallery" aria-hidden="true">
        <div class="thumb"></div><div class="thumb"></div><div class="thumb"></div>
        <div class="thumb"></div><div class="thumb"></div><div class="thumb"></div>
        <div class="thumb"></div><div class="thumb"></div><div class="thumb"></div>
      </div>
    </div>
  </div>

  <button class="btn" id="replay" aria-label="Rejouer">Rejouer</button>
  <div class="hint">Téléphone arrive → notif NFC → notif sort → vidéo plein écran</div>
</div>

<script>
(function(){
  const box = document.getElementById('demo');
  const replay = document.getElementById('replay');

  const supportsOffsetPath = 'offsetPath' in (document.body.style||{});
  if(!supportsOffsetPath){ box.classList.add('no-path'); }

  const T_ARRIVE = 1100, T_TOAST_IN = 600, T_TOAST_HOLD = 1100, T_TOAST_OUT = 400;

  function run(){
    box.className = box.className.replace(/\b(arrive|is-toast|toast-off|playing)\b/g,'').trim();
    void box.offsetWidth;

    // 1) téléphone arrive
    box.classList.add('arrive');

    // 2) notif NFC s’affiche
    setTimeout(()=>{ box.classList.add('is-toast'); }, T_ARRIVE + 150);

    // 3) notif disparaît
    setTimeout(()=>{
      box.classList.remove('is-toast');
      box.classList.add('toast-off');
    }, T_ARRIVE + 150 + T_TOAST_IN + T_TOAST_HOLD);

    // 4) vidéo plein écran apparaît
    setTimeout(()=>{
      box.classList.remove('toast-off');
      box.classList.add('playing');
    }, T_ARRIVE + 150 + T_TOAST_IN + T_TOAST_HOLD + T_TOAST_OUT + 80);
  }

  box.addEventListener('mouseenter', run);
  box.addEventListener('click', run);
  replay.addEventListener('click', e=>{ e.stopPropagation(); run(); });

  run();
})();
</script>
</body>
</html>
