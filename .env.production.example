# ==============================================================================
# FICHIER DE CONFIGURATION PRODUCTION - REVILA
# ==============================================================================
# Ce fichier contient toutes les variables d'environnement nécessaires
# pour le déploiement en production sur VPS avec Docker.
#
# INSTRUCTIONS :
# 1. Copier ce fichier : cp .env.production.example .env.production
# 2. Remplacer toutes les valeurs "your_xxx" par vos vraies valeurs
# 3. Ne JAMAIS commiter .env.production sur GitHub (déjà dans .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONNEMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# BASE DE DONNÉES POSTGRESQL
# ------------------------------------------------------------------------------
# Ces variables doivent correspondre à celles dans docker-compose.production.yml
POSTGRES_USER=revila
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT
POSTGRES_DB=revila
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de connexion complète (utilisée par certains ORM)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# SUPABASE (Base de données et stockage)
# ------------------------------------------------------------------------------
# URL de votre projet Supabase (trouvable dans Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme (publique, safe pour le client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_anon_key

# Clé service role (PRIVÉE, ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_service_role_key

# ------------------------------------------------------------------------------
# STRIPE (Paiements)
# ------------------------------------------------------------------------------
# Clés de production (commencent par pk_live_ et sk_live_)
# Trouvables sur https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE

# Secret webhook Stripe (pour vérifier les événements webhook)
# Trouvable dans Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# GOOGLE CLOUD STORAGE (Stockage des fichiers)
# ------------------------------------------------------------------------------
# Nom du bucket GCS
GCS_BUCKET_NAME=revila-production

# ID du projet Google Cloud
GCS_PROJECT_ID=revila-467910

# Email du compte de service
GCS_CLIENT_EMAIL=revila-service@revila-467910.iam.gserviceaccount.com

# Clé privée du compte de service (avec les \n pour les sauts de ligne)
# ATTENTION : Gardez les guillemets et les \n
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n...VOTRE_CLE_PRIVEE...\n-----END PRIVATE KEY-----\n"

# OU utiliser GCS_CREDENTIALS (format JSON complet) pour Railway/production
# GCS_CREDENTIALS='{"type":"service_account","project_id":"revila-467910",...}'

# ------------------------------------------------------------------------------
# N8N WEBHOOKS (Automatisation et notifications)
# ------------------------------------------------------------------------------
# Webhook pour les nouvelles commandes en test
N8N_WEBHOOK_NEW_ORDER_TEST=https://votre-n8n.com/webhook/test-new-order

# Webhook pour les nouvelles commandes en production
N8N_WEBHOOK_NEW_ORDER_PROD=https://votre-n8n.com/webhook/prod-new-order

# ------------------------------------------------------------------------------
# APPLICATION URL
# ------------------------------------------------------------------------------
# URL publique de votre application (pour les redirections, webhooks, etc.)
NEXT_PUBLIC_APP_URL=https://votre-domaine.com

# URL de base pour NextAuth (si utilisé)
NEXTAUTH_URL=https://votre-domaine.com
NEXTAUTH_SECRET=GENEREZ_UNE_CLE_SECRETE_ALEATOIRE_ICI

# ------------------------------------------------------------------------------
# REDIS (Optionnel - si vous activez Redis dans docker-compose)
# ------------------------------------------------------------------------------
# REDIS_URL=redis://:votre_password@redis:6379
# REDIS_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE

# ------------------------------------------------------------------------------
# SÉCURITÉ ET MONITORING (Optionnel)
# ------------------------------------------------------------------------------
# Secret pour signer les tokens JWT
# JWT_SECRET=GENEREZ_UNE_CLE_SECRETE_ALEATOIRE_ICI

# Sentry pour le monitoring des erreurs (optionnel)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=xxx

# ------------------------------------------------------------------------------
# VARIABLES SPÉCIFIQUES AU VPS
# ------------------------------------------------------------------------------
# IP du serveur VPS
VPS_IP=72.62.33.48

# Hostname du serveur
VPS_HOSTNAME=srv1126734.hstgr.cloud

# ------------------------------------------------------------------------------
# GÉNÉRATION DE SECRETS ALÉATOIRES
# ------------------------------------------------------------------------------
# Pour générer des secrets sécurisés, utilisez :
#
# Sur Linux/Mac :
#   openssl rand -base64 32
#
# Sur Windows PowerShell :
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
# Ou en ligne :
#   https://generate-secret.vercel.app/32
# ------------------------------------------------------------------------------

# ==============================================================================
# CHECKLIST AVANT LE DÉPLOIEMENT
# ==============================================================================
# [ ] Toutes les variables "your_xxx" ont été remplacées
# [ ] Les mots de passe sont forts et uniques
# [ ] Les clés Stripe sont en mode LIVE (pk_live_ et sk_live_)
# [ ] Le GCS_BUCKET_NAME existe et est configuré
# [ ] Les webhooks N8N sont configurés et testés
# [ ] NEXTAUTH_SECRET est généré aléatoirement
# [ ] Le fichier .env.production n'est PAS commité dans Git
# [ ] Les URLs pointent vers le domaine de production
# ==============================================================================
